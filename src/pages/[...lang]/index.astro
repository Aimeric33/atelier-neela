---
import { Image } from "astro:assets";
import ProductCard from "@/components/ProductCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import heroImg from "@/assets/atelier-hero.jpg";
import { siteConfig } from "@/config/site";
import { formatPrice, getProducts, requireProduct } from "@/data/products";
import { localeStaticPaths, localizePath, routes, useTranslations, type Locale } from "@/i18n";

export function getStaticPaths() {
  return localeStaticPaths();
}

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const products = await getProducts(lang);
const featured = siteConfig.featured.homepageGrid.map((slug) => requireProduct(products, slug));
const solo = requireProduct(products, siteConfig.featured.homepageSolo);

const siteUrl = new URL(localizePath(routes.home, lang), Astro.site ?? Astro.url.origin).href;

const facts = [
  { value: "2018", label: t.home.facts.founded },
  { value: siteConfig.location.region, label: t.home.facts.country },
  { value: String(products.length).padStart(2, "0"), label: t.home.facts.pieces },
  { value: "03", label: t.home.facts.timbers },
];

const materials = t.home.materials;

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: siteConfig.name,
  url: siteUrl,
  slogan: siteConfig.tagline[lang],
  email: siteConfig.email,
  address: {
    "@type": "PostalAddress",
    addressRegion: siteConfig.location.region,
    addressCountry: siteConfig.location.country,
  },
};
---

<BaseLayout
  title={`${siteConfig.name} — ${siteConfig.tagline[lang]}`}
  description={t.home.description}
>
  <main id="main-content">
    {/* ---------------------------------------------------------------- Hero */}
    <section class="shell grid items-center gap-x-12 gap-y-10 pb-4 pt-8 md:grid-cols-12 md:pb-10 md:pt-12">
      <div class="hero-in md:col-span-5">
        <h1 class="type-hero">{t.home.heroTitle}</h1>
        <p class="type-lead mt-7 max-w-[42ch]">{t.home.heroLead}</p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href={localizePath(routes.catalog, lang)} class="btn btn-primary">{t.common.browseCatalogue}</a>
          <a href={localizePath(routes.studio, lang)} class="btn btn-outline">{t.home.ctaWorkshop}</a>
        </div>
      </div>

      <figure class="hero-in md:col-span-7" style="--reveal-delay:120ms">
        <div class="overflow-hidden bg-surface">
          <Image
            src={heroImg}
            alt={t.home.heroAlt}
            width={1600}
            height={1400}
            format="webp"
            loading="eager"
            decoding="sync"
            class="parallax aspect-[4/3] w-full object-cover object-right md:aspect-[8/7]"
          />
        </div>
        <figcaption class="display mt-3 flex justify-between gap-4 text-[0.625rem] uppercase tracking-[0.05em] text-muted">
          <span>{t.home.heroCaption[0]}</span>
          <span>{t.home.heroCaption[1]}</span>
        </figcaption>
      </figure>
    </section>

    {/* Spec band */}
    <div class="mt-14 border-y border-line md:mt-20">
      <dl class="shell grid grid-cols-2 md:grid-cols-4">
        {
          facts.map((fact, index) => (
            <div class="fact" data-reveal style={`--reveal-delay:${index * 70}ms`}>
              <dt class="label">{fact.label}</dt>
              <dd class="mt-2.5 text-2xl font-medium tracking-[-0.03em] md:text-3xl">{fact.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    {/* --------------------------------------------------- Currently in build */}
    <section class="shell mt-24 md:mt-36">
      <div class="rule" data-reveal="line"></div>
      <div class="mt-8 flex flex-wrap items-end justify-between gap-x-8 gap-y-4" data-reveal>
        <h2 class="type-h2 max-w-[14ch]">{t.home.featuredHeading}</h2>
        <a href={localizePath(routes.catalog, lang)} class="link link-display pb-1.5 text-muted">{t.common.allPieces}</a>
      </div>

      <div class="mt-12 grid gap-x-8 gap-y-14 md:mt-14 md:grid-cols-3">
        {
          featured.map((product, index) => (
            <ProductCard product={product} index={index} revealDelay={index * 110} />
          ))
        }
      </div>
    </section>

    {/* ------------------------------------------------------------- The solo */}
    <section class="mt-24 md:mt-36">
      <div class="shell grid items-center gap-10 md:grid-cols-12 md:gap-12">
        <div class="md:col-span-7 lg:col-span-8">
          <a
            href={localizePath(routes.product(solo.slug), lang)}
            class="group block overflow-hidden bg-surface"
            data-reveal="mask"
            aria-label={`${solo.name} — ${solo.shortDescription}`}
          >
            {/* Wrapper carries the unmask clip so the image keeps its own
                hover transition — see the mask notes in src/styles.css. */}
            <div>
              <Image
                src={solo.images[0]}
                alt=""
                width={1600}
                height={1100}
                loading="lazy"
                format="webp"
                class="aspect-[5/4] w-full object-cover transition-transform duration-[1100ms] ease-out group-hover:scale-[1.04] md:aspect-[16/11]"
              />
            </div>
          </a>
        </div>

        <div class="md:col-span-5 lg:col-span-4" data-reveal style="--reveal-delay:140ms">
          <h2 class="type-h2">{t.home.soloHeading}</h2>
          <p class="type-body mt-6 max-w-[44ch]">{solo.description}</p>

          <dl class="display mt-9 border-t border-line text-[0.8125rem]">
            {
              [
                [t.home.specs.dimensions, solo.dimensions],
                [t.home.specs.finish, solo.finish],
                [t.home.specs.leadTime, solo.leadTime],
                [t.home.specs.from, formatPrice(solo.price, lang)],
              ].map(([term, value]) => (
                <div class="flex justify-between gap-6 border-b border-line py-3">
                  <dt class="text-muted">{term}</dt>
                  <dd class="text-right">{value}</dd>
                </div>
              ))
            }
          </dl>

          <a href={localizePath(routes.product(solo.slug), lang)} class="btn btn-primary mt-9">{t.home.seePiece}</a>
        </div>
      </div>
    </section>

    {/* ----------------------------------------------------------- Materials */}
    <section class="shell mt-24 md:mt-36">
      <div class="rule" data-reveal="line"></div>
      <h2 class="type-h2 mt-8 max-w-[18ch]" data-reveal>{t.home.materialsHeading}</h2>

      <div class="mt-12 grid gap-x-8 gap-y-12 md:grid-cols-3">
        {
          materials.map((material, index) => (
            <div class="border-t border-line pt-6" data-reveal style={`--reveal-delay:${index * 110}ms`}>
              <h3 class="type-h3">{material.name}</h3>
              <p class="label mt-3">{material.tag}</p>
              <p class="type-body mt-4 text-[0.9375rem]">{material.copy}</p>
            </div>
          ))
        }
      </div>
    </section>
  </main>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(organizationSchema)}></script>
</BaseLayout>
