---
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import handsImg from "@/assets/atelier-hands.jpg";
import workshopImg from "@/assets/atelier-workshop.jpg";
import { siteConfig, pageTitle } from "@/config/site";
import { localeStaticPaths, localizePath, routes, useTranslations, type Locale } from "@/i18n";

export function getStaticPaths() {
  return localeStaticPaths();
}

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<BaseLayout
  title={pageTitle(t.about.title)}
  description={t.about.description}
  image={workshopImg}
>
  <main id="main-content">
    <section class="shell pb-12 pt-12 md:pb-16 md:pt-20">
      <h1 class="type-h1 hero-in max-w-[11ch]">{t.about.heading}</h1>
      <p class="type-lead hero-in mt-8 max-w-[58ch]" style="--reveal-delay:120ms">{t.about.lead}</p>
    </section>

    <figure class="hero-in overflow-hidden bg-surface" style="--reveal-delay:260ms">
      <Image
        src={workshopImg}
        alt={t.about.workshopAlt}
        width={1920}
        height={1080}
        format="webp"
        loading="eager"
        decoding="sync"
        class="parallax h-[50vh] w-full object-cover md:h-[72vh]"
      />
    </figure>

    {/* -------------------------------------------------------------- Origin */}
    <section class="shell mt-24 grid gap-8 md:mt-36 md:grid-cols-12">
      <div class="md:col-span-5" data-reveal>
        <h2 class="type-h2 max-w-[12ch]">{t.about.originHeading}</h2>
      </div>
      <div class="md:col-span-6 md:col-start-7" data-reveal style="--reveal-delay:120ms">
        {t.about.origin.map((paragraph, index) => <p class:list={["type-body", index > 0 && "mt-5"]}>{paragraph}</p>)}
      </div>
    </section>

    {/* ---------------------------------------------------------- Principles */}
    <section class="shell mt-24 md:mt-36">
      <div class="rule" data-reveal="line"></div>
      <h2 class="type-h2 mt-8 max-w-[16ch]" data-reveal>{t.about.principlesHeading}</h2>

      <div class="mt-12 grid gap-x-8 gap-y-12 md:grid-cols-3">
        {
          t.about.principles.map((principle, index) => (
            <div class="border-t border-line pt-6" data-reveal style={`--reveal-delay:${index * 110}ms`}>
              <h3 class="type-h3">{principle.heading}</h3>
              <p class="type-body mt-4 text-[0.9375rem]">{principle.copy}</p>
            </div>
          ))
        }
      </div>
    </section>

    {/* ----------------------------------------------------------- Materials */}
    <section class="shell mt-24 grid items-center gap-10 md:mt-36 md:grid-cols-12 md:gap-12">
      <div class="md:col-span-5">
        <div class="overflow-hidden bg-surface" data-reveal="mask">
          <div>
            <Image
              src={handsImg}
              alt={t.about.handsAlt}
              width={1080}
              height={1440}
              format="webp"
              loading="lazy"
              class="aspect-[3/4] w-full object-cover"
            />
          </div>
        </div>
      </div>

      <div class="md:col-span-6 md:col-start-7" data-reveal style="--reveal-delay:140ms">
        <blockquote>
          <p class="type-h3 max-w-[26ch] text-[clamp(1.5rem,2.8vw,2.25rem)] leading-[1.15]">
            {t.about.quote}
          </p>
          <footer class="label mt-6">{t.about.quoteAuthor}</footer>
        </blockquote>
        <p class="type-body mt-8 max-w-[48ch] border-t border-line pt-6 text-[0.9375rem]">
          {t.about.timbers}
        </p>
      </div>
    </section>

    {/* --------------------------------------------------------------- Facts */}
    <section class="mt-24 border-y border-line md:mt-36" aria-label={t.about.factsLabel}>
      <dl class="shell grid grid-cols-2 md:grid-cols-4">
        {
          t.about.facts.map((fact, index) => (
            <div class="fact" data-reveal style={`--reveal-delay:${index * 70}ms`}>
              <dt class="label">{fact.label}</dt>
              <dd class="mt-2.5 text-2xl font-medium tracking-[-0.03em] md:text-3xl">{fact.value}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    {/* ----------------------------------------------------------------- CTA */}
    <section id="studio" class="shell mt-24 md:mt-36">
      <div class="grid items-end gap-8 md:grid-cols-12" data-reveal>
        <div class="md:col-span-7">
          <h2 class="type-h2 max-w-[16ch]">{t.about.ctaHeading}</h2>
        </div>
        <div class="flex flex-wrap gap-3 md:col-span-5 md:justify-end">
          <a href={localizePath(routes.catalog, lang)} class="btn btn-primary">{t.about.ctaCatalog}</a>
          <a href={`mailto:${siteConfig.email}`} class="btn btn-outline">{t.about.ctaWrite}</a>
        </div>
      </div>
    </section>
  </main>

</BaseLayout>
