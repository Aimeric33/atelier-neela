---
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig, pageTitle } from "@/config/site";
import { formatPrice, getProducts, productForJson } from "@/data/products";
import { fill, localeMeta, localeStaticPaths, localizePath, routes, useTranslations, type Locale } from "@/i18n";

export function getStaticPaths() {
  return localeStaticPaths();
}

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const catalogHref = localizePath(routes.catalog, lang);
const products = await getProducts(lang);

// Everything the client-side cart needs travels in one JSON payload, so the
// inline script never hardcodes currency, locale, copy or delivery pricing.
const cartData = {
  ...siteConfig.commerce,
  locale: localeMeta[lang].intl,
  products: products.map(productForJson),
  strings: {
    titles: t.cart.titles,
    continueToDetails: t.cart.continueToDetails,
    reserve: t.cart.reserve,
    previewAlert: t.cart.previewAlert,
  },
};
const zero = formatPrice(0, lang);
---

<BaseLayout
  title={pageTitle(t.cart.title)}
  description={t.cart.description(siteConfig.name)}
  noindex={true}
>
  <main id="main-content" class="shell py-12">
    <header class="flex flex-wrap items-end justify-between gap-x-8 gap-y-6 border-b border-line pb-8">
      <h1 class="type-h1" data-cart-title>{t.cart.titles.empty}</h1>
      <ol class="mono hidden gap-7 text-[0.6875rem] uppercase tracking-[0.05em] md:flex">
        <li data-cart-step="cart">{t.cart.steps[0]}</li>
        <li data-cart-step="details">{t.cart.steps[1]}</li>
        <li class="text-muted">{t.cart.steps[2]}</li>
      </ol>
    </header>

    <div class="py-28 text-center" data-cart-empty>
      <p class="type-body mx-auto max-w-[42ch]">{t.cart.emptyCopy}</p>
      <a href={catalogHref} class="btn btn-primary mt-8">{t.common.browseCatalogue}</a>
    </div>

    <div class="hidden grid-cols-1 items-start gap-x-12 gap-y-12 pt-10 lg:grid-cols-12" data-cart-filled>
      <section class="lg:col-span-7" aria-label={t.cart.selectedLabel}>
        <ul class="border-t border-line" data-cart-list aria-live="polite"></ul>

        <form id="checkout-form" class="hidden space-y-12" data-checkout-form novalidate>
          <fieldset>
            <legend class="label">{t.cart.contact}</legend>
            <div class="mt-5">
              <label class="field-label" for="checkout-email">{t.cart.email}</label>
              <input
                id="checkout-email"
                name="email"
                type="email"
                required
                autocomplete="email"
                placeholder="email@example.com"
                class="field mono"
              />
            </div>
          </fieldset>

          <fieldset>
            <legend class="label">{t.cart.delivery}</legend>
            <div class="mt-5 grid gap-6 sm:grid-cols-2">
              <div>
                <label class="field-label" for="checkout-first">{t.cart.firstName}</label>
                <input
                  id="checkout-first"
                  name="firstName"
                  required
                  autocomplete="given-name"
                  placeholder={t.cart.placeholders.firstName}
                  class="field mono"
                />
              </div>
              <div>
                <label class="field-label" for="checkout-last">{t.cart.lastName}</label>
                <input
                  id="checkout-last"
                  name="lastName"
                  required
                  autocomplete="family-name"
                  placeholder={t.cart.placeholders.lastName}
                  class="field mono"
                />
              </div>
              <div class="sm:col-span-2">
                <label class="field-label" for="checkout-address">{t.cart.street}</label>
                <input
                  id="checkout-address"
                  name="address"
                  required
                  autocomplete="street-address"
                  placeholder={t.cart.placeholders.street}
                  class="field mono"
                />
              </div>
              <div>
                <label class="field-label" for="checkout-city">{t.cart.city}</label>
                <input
                  id="checkout-city"
                  name="city"
                  required
                  autocomplete="address-level2"
                  placeholder={t.cart.placeholders.city}
                  class="field mono"
                />
              </div>
              <div>
                <label class="field-label" for="checkout-postcode">{t.cart.postcode}</label>
                <input
                  id="checkout-postcode"
                  name="postalCode"
                  required
                  autocomplete="postal-code"
                  placeholder={t.cart.placeholders.postcode}
                  class="field mono"
                />
              </div>
            </div>
          </fieldset>

          <fieldset>
            <legend class="label">{t.cart.payment}</legend>
            <div class="mt-5 grid gap-6 sm:grid-cols-2">
              <div class="sm:col-span-2">
                <label class="field-label" for="checkout-card">{t.cart.cardNumber}</label>
                <input
                  id="checkout-card"
                  name="cardNumber"
                  required
                  inputmode="numeric"
                  autocomplete="cc-number"
                  placeholder="4242 4242 4242 4242"
                  maxlength="19"
                  data-card-number
                  class="field mono"
                />
              </div>
              <div>
                <label class="field-label" for="checkout-expiry">{t.cart.expiry}</label>
                <input
                  id="checkout-expiry"
                  name="cardExpiry"
                  required
                  inputmode="numeric"
                  autocomplete="cc-exp"
                  placeholder={t.cart.placeholders.expiry}
                  maxlength="7"
                  data-card-expiry
                  class="field mono"
                />
              </div>
              <div>
                <label class="field-label" for="checkout-cvc">{t.cart.cvc}</label>
                <input
                  id="checkout-cvc"
                  name="cardCvc"
                  required
                  inputmode="numeric"
                  autocomplete="cc-csc"
                  placeholder="123"
                  maxlength="3"
                  data-card-cvc
                  class="field mono"
                />
              </div>
            </div>
          </fieldset>
        </form>
      </section>

      <aside class="border-t border-line pt-6 lg:sticky lg:top-28 lg:col-span-5" aria-label={t.cart.summaryLabel}>
        <h2 class="label">{t.cart.summary}</h2>

        <dl class="mono mt-6 text-[0.8125rem]">
          <div class="flex justify-between border-b border-line py-3">
            <dt class="text-muted">{t.cart.subtotal}</dt>
            <dd data-cart-subtotal>{zero}</dd>
          </div>
          <div class="flex justify-between border-b border-line py-3">
            <dt class="text-muted">{t.cart.shipping}</dt>
            <dd data-cart-shipping>{zero}</dd>
          </div>
          <div class="flex items-baseline justify-between pt-5">
            <dt class="label">{t.cart.total}</dt>
            <dd class="mono text-2xl" data-cart-total>{zero}</dd>
          </div>
        </dl>

        <button type="button" class="btn btn-primary mt-8 w-full" data-cart-primary>{t.cart.continueToDetails}</button>
        <button type="button" class="link link-mono mt-5 hidden text-muted" data-cart-back>{t.cart.back}</button>

        <p class="type-body mt-8 border-t border-line pt-6 text-[0.8125rem]">{t.cart.note}</p>
      </aside>
    </div>

    {
      products.map((product) => (
        <template data-product-template={product.slug}>
          <li class="flex gap-6 border-b border-line py-6" data-cart-row={product.slug}>
            <a
              href={localizePath(routes.product(product.slug), lang)}
              class="block size-24 shrink-0 overflow-hidden bg-surface md:size-28"
              tabindex="-1"
              aria-hidden="true"
            >
              <Image
                src={product.images[0]}
                alt=""
                width={320}
                height={320}
                format="webp"
                loading="eager"
                class="h-full w-full object-cover"
              />
            </a>
            <div class="flex min-w-0 flex-1 flex-col justify-between gap-4">
              <div class="flex justify-between gap-4">
                <div class="min-w-0">
                  <a href={localizePath(routes.product(product.slug), lang)} class="link text-[0.9375rem] font-medium">
                    {product.name}
                  </a>
                  <p class="mono mt-1.5 text-[0.6875rem] uppercase tracking-[0.05em] text-muted">
                    {product.material} · {product.finish}
                  </p>
                  <p class="mono mt-1 text-[0.6875rem] uppercase tracking-[0.05em] text-muted">
                    {t.common.leadTime} {product.leadTime}
                  </p>
                </div>
                <span class="mono whitespace-nowrap text-[0.8125rem]" data-row-line-price>
                  {formatPrice(product.price, lang)}
                </span>
              </div>
              <div class="flex items-center justify-between gap-4">
                <div class="qty qty-sm">
                  <button
                    type="button"
                    data-cart-action="decrease"
                    aria-label={fill(t.common.decreaseQuantity, { name: product.name })}
                  >
                    −
                  </button>
                  <output data-row-quantity>1</output>
                  <button
                    type="button"
                    data-cart-action="increase"
                    aria-label={fill(t.common.increaseQuantity, { name: product.name })}
                  >
                    +
                  </button>
                </div>
                <button
                  type="button"
                  class="link link-mono text-muted"
                  data-cart-action="remove"
                  aria-label={fill(t.common.removeFromCart, { name: product.name })}
                >
                  {t.common.remove}
                </button>
              </div>
            </div>
          </li>
        </template>
      ))
    }
  </main>

  <script is:inline type="application/json" id="cart-data" set:html={JSON.stringify(cartData)}></script>

  <script is:inline>
    (() => {
      const cartData = JSON.parse(document.getElementById("cart-data").textContent);
      const strings = cartData.strings;
      const productsBySlug = new Map(cartData.products.map((product) => [product.slug, product]));
      const formatPrice = (value) =>
        new Intl.NumberFormat(cartData.locale, {
          style: "currency",
          currency: cartData.currency,
          maximumFractionDigits: 0,
        }).format(value);

      const title = document.querySelector("[data-cart-title]");
      const empty = document.querySelector("[data-cart-empty]");
      const filled = document.querySelector("[data-cart-filled]");
      const list = document.querySelector("[data-cart-list]");
      const form = document.querySelector("[data-checkout-form]");
      const primary = document.querySelector("[data-cart-primary]");
      const back = document.querySelector("[data-cart-back]");
      const subtotalNode = document.querySelector("[data-cart-subtotal]");
      const shippingNode = document.querySelector("[data-cart-shipping]");
      const totalNode = document.querySelector("[data-cart-total]");
      const stepCart = document.querySelector('[data-cart-step="cart"]');
      const stepDetails = document.querySelector('[data-cart-step="details"]');
      const cardNumber = document.querySelector("[data-card-number]");
      const cardExpiry = document.querySelector("[data-card-expiry]");
      const cardCvc = document.querySelector("[data-card-cvc]");
      let step = "cart";

      const digitsOnly = (value, maxLength) => value.replace(/\D/g, "").slice(0, maxLength);
      const formatCardNumber = (value) => digitsOnly(value, 16).replace(/(.{4})/g, "$1 ").trim();

      function formatExpiry(value) {
        const digits = digitsOnly(value, 4);
        return digits.length <= 2 ? digits : `${digits.slice(0, 2)} / ${digits.slice(2)}`;
      }

      function knownRows() {
        return window.AtelierCart.read()
          .map((item) => ({ item, product: productsBySlug.get(item.slug) }))
          .filter((row) => row.product);
      }

      function render() {
        const rows = knownRows();
        const subtotal = rows.reduce((total, row) => total + row.product.price * row.item.quantity, 0);
        const shipping = rows.length > 0 ? cartData.shippingFlatRate : 0;
        const total = subtotal + shipping;

        if (rows.length === 0) step = "cart";

        title.textContent = rows.length === 0 ? strings.titles.empty : strings.titles[step];
        empty.classList.toggle("hidden", rows.length !== 0);
        filled.classList.toggle("hidden", rows.length === 0);
        filled.classList.toggle("grid", rows.length !== 0);
        list.classList.toggle("hidden", step !== "cart");
        form.classList.toggle("hidden", step !== "details");
        primary.textContent =
          step === "cart" ? strings.continueToDetails : strings.reserve.replace("{total}", formatPrice(total));
        back.classList.toggle("hidden", step !== "details");
        stepCart.classList.toggle("text-muted", step !== "cart");
        stepDetails.classList.toggle("text-muted", step !== "details");

        subtotalNode.textContent = formatPrice(subtotal);
        shippingNode.textContent = formatPrice(shipping);
        totalNode.textContent = formatPrice(total);

        list.replaceChildren();
        rows.forEach(({ item, product }) => {
          const template = document.querySelector(`template[data-product-template="${item.slug}"]`);
          const row = template.content.firstElementChild.cloneNode(true);
          row.querySelector("[data-row-quantity]").textContent = String(item.quantity);
          row.querySelector("[data-row-line-price]").textContent = formatPrice(product.price * item.quantity);
          row
            .querySelector('[data-cart-action="decrease"]')
            .addEventListener("click", () => window.AtelierCart.setQuantity(item.slug, item.quantity - 1));
          row
            .querySelector('[data-cart-action="increase"]')
            .addEventListener("click", () => window.AtelierCart.setQuantity(item.slug, item.quantity + 1));
          row
            .querySelector('[data-cart-action="remove"]')
            .addEventListener("click", () => window.AtelierCart.remove(item.slug));
          list.appendChild(row);
        });
      }

      primary.addEventListener("click", () => {
        if (step === "cart") {
          step = "details";
          render();
          return;
        }
        form.requestSubmit();
      });

      back.addEventListener("click", () => {
        step = "cart";
        render();
      });

      form.addEventListener("submit", (event) => {
        event.preventDefault();
        if (!form.checkValidity()) {
          form.reportValidity();
          return;
        }
        window.alert(strings.previewAlert);
      });

      cardNumber.addEventListener("input", () => (cardNumber.value = formatCardNumber(cardNumber.value)));
      cardExpiry.addEventListener("input", () => (cardExpiry.value = formatExpiry(cardExpiry.value)));
      cardCvc.addEventListener("input", () => (cardCvc.value = digitsOnly(cardCvc.value, 3)));

      document.addEventListener("atelier-cart-change", render);
      render();
    })();
  </script>
</BaseLayout>
