---
import { Image } from "astro:assets";
import CartDrawer from "@/components/CartDrawer.astro";
import { siteConfig } from "@/config/site";
import { formatPrice, getProducts, requireProduct } from "@/data/products";
import {
  getLocale,
  localeMeta,
  locales,
  localizePath,
  routes,
  stripLocale,
  useTranslations,
} from "@/i18n";

const lang = getLocale(Astro.url);
const t = useTranslations(lang);

// Active state is matched on the unprefixed path, so "/en/catalogue" and
// "/catalogue" both light up the catalogue item.
const currentPath = stripLocale(Astro.url.pathname);
const isActive = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath.startsWith(href);

const navItems = siteConfig.navigation.map((item) => ({
  label: item.label[lang],
  href: localizePath(item.href, lang),
  active: isActive(item.href),
  children: item.children?.map((child) => ({
    label: child.label[lang],
    href: localizePath(child.href, lang),
  })),
}));

// Desktop bar: items with a dropdown sit on the left, right after the name;
// the other links go on the right. "Accueil" is left out there since the
// name already links home — the mobile menu still lists every item.
const dropdownItems = navItems.filter((item) => item.children);
const linkItems = navItems.filter(
  (item) => !item.children && item.href !== localizePath(routes.home, lang),
);
const cartHref = localizePath(routes.cart, lang);

// One link per other locale, pointing at the same page in that language. The
// 404 is a single root page with no translations, so it links home instead.
const isNotFound = /^\/404\/?$/.test(currentPath);
const languageLinks = locales
  .filter((locale) => locale !== lang)
  .map((locale) => ({
    locale,
    short: localeMeta[locale].short,
    label: useTranslations(locale).common.switchLanguage,
    href: localizePath(isNotFound ? routes.home : currentPath, locale),
  }));

const featuredProduct = requireProduct(await getProducts(lang), siteConfig.featured.mobileMenu);
const cartIndex = String(navItems.length + 1).padStart(2, "0");
---

<header class="shell fixed top-[1.5rem] z-50">
  <nav class="site-header flex items-stretch justify-between" aria-label={t.common.mainNav}>
    <div class="flex items-stretch border-r border-accent">
      <a
        href={localizePath(routes.home, lang)}
        class="py-2 px-6 uppercase border-r border-accent hover:text-accent"
        aria-label={t.common.homeLabel(siteConfig.name)}
      >
        {siteConfig.name}
      </a>

      <ul class="hidden items-center md:flex">
        {
          dropdownItems.map((item) => (
            <li class="group relative">
              <div
                class:list={["nav-link", item.active && "is-current"]}
                aria-current={item.active ? "page" : undefined}
                aria-haspopup="true"
              >
                <span class="inline-flex items-center gap-2">
                  {item.label}
                  <svg
                    class="transition-transform duration-300 group-hover:rotate-180 group-focus-within:rotate-180"
                    aria-hidden="true"
                    width="8"
                    height="5"
                    viewBox="0 0 8 5"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.2"
                  >
                    <path d="M.5.5 4 4 7.5.5" />
                  </svg>
                </span>
              </div>
              {/* pt-4 bridges the gap so the panel doesn't close on the way down. */}
              <div class="invisible absolute left-1/2 top-full z-10 -translate-x-1/2 pt-4 opacity-0 transition-opacity duration-200 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
                <ul class="min-w-[12rem] border border-ink bg-canvas">
                  {item.children?.map((child) => (
                    <li class="border-b border-ink last:border-b-0">
                      <a
                        href={child.href}
                        class="link-display block whitespace-nowrap px-5 py-3.5 transition-colors hover:bg-ink hover:text-canvas"
                      >
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </li>
          ))
        }
      </ul>
    </div>

    <ul class="ml-auto border-l border-accent hidden items-stretch md:flex">
      {
        linkItems.map((item) => (
          <li class="flex">
            <a
              href={item.href}
              class:list={[
                "nav-link flex items-center border-r border-accent",
                item.active && "is-current",
              ]}
              aria-current={item.active ? "page" : undefined}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-stretch">
      {
        /* Icon only: the accessible name comes from aria-label, kept in step
          with the count by `data-cart-label`. */
      }
      <a
        href={cartHref}
        data-cart-toggle
        data-cart-label
        aria-label={t.common.cartLabel.other.replace("{n}", "0")}
        aria-expanded="false"
        aria-controls="cart-drawer-panel"
        class="nav-link inline-flex items-center border-r border-accent transition-colors hover:text-accent"
      >
        <svg width="12" height="14" viewBox="0 0 15 17" fill="none" aria-hidden="true">
          <path
            d="M2.20665 4.0289H12.7949L13.6766 16.3747L1.32349 16.3749L2.20665 4.0289Z"
            stroke="currentColor"
            stroke-width="1.5"></path>
          <path
            d="M4.5 0.625671L10.5 0.624939L10.5 3.99994H4.5L4.5 0.625671Z"
            stroke="currentColor"
            stroke-width="1.5"></path>
        </svg>
      </a>
      {
        languageLinks.map((link) => (
          <a
            href={link.href}
            hreflang={link.locale}
            lang={link.locale}
            aria-label={link.label}
            class="nav-link hidden items-center transition-colors hover:text-accent md:inline-flex"
          >
            {link.short}
          </a>
        ))
      }
      <button
        type="button"
        class="-mr-2 inline-flex size-10 items-center justify-center transition-colors hover:text-accent md:hidden"
        aria-controls="mobile-menu"
        aria-expanded="false"
        data-mobile-menu-open
      >
        <span class="sr-only">{t.common.openMenu}</span>
        <span class="flex w-[1.125rem] flex-col gap-[5px]" aria-hidden="true">
          <span class="h-px w-full bg-current"></span>
          <span class="h-px w-full bg-current"></span>
        </span>
      </button>
    </div>
  </nav>
</header>

<div
  id="mobile-menu"
  class="fixed inset-0 z-[60] h-dvh bg-canvas md:hidden"
  role="dialog"
  aria-modal="true"
  aria-label={t.common.siteMenu}
  data-mobile-menu
  hidden
>
  <div class="flex h-full flex-col px-[var(--gutter)] pb-8 pt-0">
    <div class="flex h-[4.5rem] shrink-0 items-center justify-between">
      <span class="text-[0.9375rem] font-semibold uppercase tracking-[-0.01em]"
        >{t.common.menu}</span
      >
      <button
        type="button"
        class="-mr-2 inline-flex size-10 items-center justify-center transition-colors hover:text-accent"
        data-mobile-menu-close
      >
        <span class="sr-only">{t.common.closeMenu}</span>
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.25"
          aria-hidden="true"
        >
          <path d="M5 5l14 14"></path>
          <path d="M19 5L5 19"></path>
        </svg>
      </button>
    </div>

    <ul class="mt-6 border-t border-line">
      {
        navItems.map((item, index) => (
          <li class="menu-item border-b border-line" style={`--i:${index}`}>
            <a
              href={item.href}
              class:list={[
                "flex items-baseline gap-4 py-5 transition-colors hover:text-accent",
                !item.active && "text-muted",
              ]}
              aria-current={item.active ? "page" : undefined}
              data-mobile-menu-link
            >
              <span class="display text-[0.875rem] text-accent">
                {String(index + 1).padStart(2, "0")}
              </span>
              <span class="type-h3">{item.label}</span>
            </a>
          </li>
        ))
      }
      <li class="menu-item border-b border-line" style={`--i:${navItems.length}`}>
        <a
          href={cartHref}
          data-cart-label
          aria-label={t.common.cartLabel.other.replace("{n}", "0")}
          class="flex items-baseline gap-4 py-5 text-muted transition-colors hover:text-accent"
          data-mobile-menu-link
        >
          <span class="display text-[0.875rem] text-accent">{cartIndex}</span>
          <span class="type-h3">{t.common.cart}</span>
          <span class="display ml-auto self-center text-[0.875rem]" data-cart-count>00</span>
        </a>
      </li>
    </ul>

    <div class="menu-item mt-6 flex gap-5" style={`--i:${navItems.length + 1}`}>
      {
        languageLinks.map((link) => (
          <a
            href={link.href}
            hreflang={link.locale}
            lang={link.locale}
            class="link link-display text-muted"
            data-mobile-menu-link
          >
            {link.label}
          </a>
        ))
      }
    </div>

    <a
      href={localizePath(routes.product(featuredProduct.slug), lang)}
      class="menu-item group mt-auto block pt-8"
      style={`--i:${navItems.length + 2}`}
      data-mobile-menu-link
    >
      <div class="overflow-hidden bg-surface">
        <Image
          src={featuredProduct.images[0]}
          alt={`${featuredProduct.name} — ${featuredProduct.shortDescription}`}
          width={900}
          height={560}
          format="webp"
          loading="lazy"
          class="aspect-[16/10] max-h-[28dvh] w-full object-cover transition-transform duration-[900ms] ease-out group-hover:scale-[1.04]"
        />
      </div>
      <div class="mt-3 flex items-baseline justify-between gap-4">
        <p class="label">{t.common.inTheWorkshop} — {featuredProduct.name}</p>
        <p class="display text-[0.875rem]">{formatPrice(featuredProduct.price, lang)}</p>
      </div>
    </a>
  </div>
</div>

<CartDrawer />

<style>
  .nav-link {
    padding: 0.5rem 1.5rem;
    text-transform: uppercase;
    letter-spacing: -0.03em;
    font-size: 0.8125rem;
    font-weight: 500;
    transition: color 240ms ease;
  }

  .nav-link:hover {
    color: var(--accent);
  }

  [data-mobile-menu][hidden] {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    [data-mobile-menu]:not([hidden]) {
      animation: menu-in 320ms var(--ease-out-expo) both;
    }

    [data-mobile-menu]:not([hidden]) .menu-item {
      animation: menu-item-in 620ms var(--ease-out-expo) both;
      animation-delay: calc(120ms + var(--i, 0) * 55ms);
    }

    @keyframes menu-in {
      from {
        opacity: 0;
        clip-path: inset(0 0 100% 0);
      }
    }

    @keyframes menu-item-in {
      from {
        opacity: 0;
        transform: translate3d(0, 1.25rem, 0);
      }
    }
  }
</style>

<script is:inline>
  (() => {
    const menu = document.querySelector("[data-mobile-menu]");
    const openButton = document.querySelector("[data-mobile-menu-open]");
    const closeButton = document.querySelector("[data-mobile-menu-close]");

    if (!menu || !openButton || !closeButton) return;

    const focusableSelector =
      "a[href],button:not([disabled]),input:not([disabled]),[tabindex]:not([tabindex='-1'])";
    let lastFocused = null;

    function getFocusable() {
      return Array.from(menu.querySelectorAll(focusableSelector)).filter(
        (node) => node.offsetParent !== null,
      );
    }

    function openMenu() {
      lastFocused = document.activeElement;
      menu.hidden = false;
      openButton.setAttribute("aria-expanded", "true");
      document.documentElement.style.overflow = "hidden";
      closeButton.focus({ preventScroll: true });
    }

    function closeMenu({ restoreFocus = true } = {}) {
      menu.hidden = true;
      openButton.setAttribute("aria-expanded", "false");
      document.documentElement.style.overflow = "";
      if (restoreFocus && lastFocused) lastFocused.focus({ preventScroll: true });
    }

    openButton.addEventListener("click", openMenu);
    closeButton.addEventListener("click", () => closeMenu());

    menu.querySelectorAll("[data-mobile-menu-link]").forEach((link) => {
      link.addEventListener("click", () => closeMenu({ restoreFocus: false }));
    });

    document.addEventListener("keydown", (event) => {
      if (menu.hidden) return;

      if (event.key === "Escape") {
        event.preventDefault();
        closeMenu();
        return;
      }

      if (event.key !== "Tab") return;

      const focusable = getFocusable();
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (!first || !last) return;

      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });

    window.addEventListener("resize", () => {
      if (!menu.hidden && window.matchMedia("(min-width: 768px)").matches) {
        closeMenu({ restoreFocus: false });
      }
    });
  })();
</script>
