---
/**
 * Full-bleed parallax slideshow with thumbnails, used as the homepage hero
 * background. Adapted from Osmo Supply's "Parallax Image Gallery with
 * Thumbnails": the markup, `data-slideshow` hooks, class names and GSAP
 * timeline are kept as shipped. Project-specific changes:
 *
 * - images go through the Astro pipeline (WebP, explicit sizes);
 * - thumbnails are <button>s with a label, so they work from the keyboard;
 * - corners follow the theme's --radius token (square) instead of 0.5em;
 * - optional autoplay (`autoplay` prop, in seconds), restarted after every
 *   change so a click or drag always gets a full interval before the next,
 *   with a pause/play button after the thumbnails;
 * - inactive thumbnails sit under a dark veil that lifts on hover;
 * - under prefers-reduced-motion, slides swap without the wipe and never
 *   advance on their own;
 * - anything passed as children is laid over the slides, bottom left.
 */
import { Image } from "astro:assets";
import { fill } from "@/i18n";

interface Props {
  slides: { src: ImageMetadata; alt: string }[];
  /** Accessible label for each thumbnail, with an `{i}` placeholder. */
  thumbLabel: string;
  /** Seconds each slide stays before advancing on its own. 0 turns autoplay off. */
  autoplay?: number;
  /** Accessible labels of the autoplay toggle, in each state. */
  pauseLabel: string;
  playLabel: string;
}

const { slides, thumbLabel, autoplay = 6, pauseLabel, playLabel } = Astro.props;
---

<div data-slideshow="wrap" data-slideshow-autoplay={autoplay} class="img-slider">
  <div class="img-slider__list">
    {
      slides.map((slide, index) => (
        <div data-slideshow="slide" class:list={["img-slide", index === 0 && "is--current"]}>
          <Image
            data-slideshow="parallax"
            src={slide.src}
            alt={slide.alt}
            width={2400}
            widths={[960, 1600, 2400]}
            sizes="100vw"
            format="webp"
            loading={index === 0 ? "eager" : "lazy"}
            decoding={index === 0 ? "sync" : "async"}
            draggable="false"
            class="img-slide__inner"
          />
        </div>
      ))
    }
  </div>

  {/* Darkens the bottom-left corner so the overlaid copy stays legible on any slide. */}
  <div class="img-slider__shade" aria-hidden="true"></div>

  <div class="img-slider__content">
    <slot />
  </div>

  <div class="img-slider__nav">
    {
      slides.map((slide, index) => (
        <button
          type="button"
          data-slideshow="thumb"
          class:list={["img-slider__thumb", index === 0 && "is--current"]}
          aria-label={fill(thumbLabel, { i: index + 1 })}
          aria-pressed={index === 0 ? "true" : "false"}
        >
          <Image
            src={slide.src}
            alt=""
            width={224}
            height={150}
            format="webp"
            loading="eager"
            draggable="false"
            class="slider-thumb__img"
          />
        </button>
      ))
    }
    {
      autoplay > 0 && (
        <button
          type="button"
          data-slideshow="toggle"
          data-state="playing"
          data-label-pause={pauseLabel}
          data-label-play={playLabel}
          class="img-slider__toggle"
          aria-label={pauseLabel}
        >
          <svg class="icon-pause" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
            <rect x="3" y="2" width="2.5" height="10" fill="currentColor" />
            <rect x="8.5" y="2" width="2.5" height="10" fill="currentColor" />
          </svg>
          <svg class="icon-play" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
            <path d="M4 2.2v9.6L11.5 7z" fill="currentColor" />
          </svg>
        </button>
      )
    }
  </div>
</div>

<style>
  .img-slider {
    grid-column-gap: 1rem;
    grid-row-gap: 1rem;
    border-radius: var(--radius);
    justify-content: center;
    align-items: flex-end;
    width: 100%;
    /* Fills the viewport under the sticky header (4.5rem). */
    height: calc(100svh - 4.5rem);
    min-height: 34rem;
    display: flex;
    position: relative;
    overflow: hidden;
    background: var(--ink);
  }

  .img-slider__list {
    grid-template-rows: 100%;
    grid-template-columns: 100%;
    place-items: center;
    width: 100%;
    height: 100%;
    display: grid;
    overflow: hidden;
  }

  .img-slide {
    opacity: 0;
    pointer-events: none;
    will-change: transform, opacity;
    grid-area: 1 / 1 / -1 / -1;
    place-items: center;
    width: 100%;
    height: 100%;
    display: grid;
    position: relative;
    overflow: hidden;
  }

  .img-slide.is--current {
    opacity: 1;
    pointer-events: auto;
  }

  .img-slide__inner {
    object-fit: cover;
    will-change: transform;
    width: 100%;
    height: 100%;
    position: absolute;
    user-select: none;
  }

  .img-slider__shade {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      linear-gradient(to top, rgb(0 0 0 / 0.6), rgb(0 0 0 / 0) 60%),
      linear-gradient(to right, rgb(0 0 0 / 0.35), rgb(0 0 0 / 0) 55%);
  }

  /* Overlaid copy: bottom left, above the thumbnails on small screens. */
  .img-slider__content {
    position: absolute;
    z-index: 2;
    left: var(--gutter);
    right: var(--gutter);
    bottom: calc(2rem + 3rem + 2rem);
    max-width: 40rem;
    color: var(--canvas);
  }

  .img-slider__content :global(.type-lead) {
    color: color-mix(in oklab, var(--canvas) 85%, transparent);
  }

  .img-slider__content :global(.btn-outline) {
    color: var(--canvas);
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--canvas) 55%, transparent);
  }

  .img-slider__content :global(.btn-outline:hover),
  .img-slider__content :global(.btn-outline:focus-visible) {
    box-shadow: inset 0 0 0 1px var(--accent);
  }

  .img-slider__nav {
    /* Thumbnail width; the toggle matches the thumbnails' height. */
    --thumb-width: 7rem;
    z-index: 2;
    grid-column-gap: 0.5rem;
    grid-row-gap: 0.5rem;
    pointer-events: none;
    flex-flow: wrap;
    justify-content: center;
    align-items: center;
    max-width: 95vw;
    display: flex;
    position: absolute;
    bottom: 2rem;
  }

  .img-slider__thumb {
    aspect-ratio: 1.5;
    pointer-events: auto;
    cursor: pointer;
    border: 1px solid #fff3;
    border-radius: var(--radius);
    width: var(--thumb-width);
    padding: 0;
    transition: border-color 0.2s;
    position: relative;
    overflow: hidden;
  }

  /* Veil over inactive thumbnails, lifted on hover and on the current one. */
  .img-slider__thumb::after {
    content: "";
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / 0.5);
    pointer-events: none;
    transition: opacity 0.3s;
  }

  .img-slider__thumb:hover {
    border-color: #fff6;
  }

  .img-slider__thumb:hover::after {
    opacity: 0.4;
  }

  .img-slider__thumb.is--current {
    border-color: #fff;
  }

  .img-slider__thumb.is--current::after {
    opacity: 0;
  }

  .img-slider__toggle {
    display: grid;
    place-items: center;
    flex: none;
    width: calc(var(--thumb-width) / 1.5);
    aspect-ratio: 1;
    pointer-events: auto;
    cursor: pointer;
    color: #fff;
    background: rgb(0 0 0 / 0.35);
    border: 1px solid #fff3;
    border-radius: var(--radius);
    transition:
      border-color 0.2s,
      background-color 0.2s;
  }

  .img-slider__toggle:hover {
    border-color: #fff;
    background: rgb(0 0 0 / 0.55);
  }

  .img-slider__toggle[data-state="playing"] .icon-play,
  .img-slider__toggle[data-state="paused"] .icon-pause {
    display: none;
  }

  .slider-thumb__img {
    object-fit: cover;
    width: 100%;
    height: 100%;
  }

  /* Side by side from tablet up: copy bottom left, thumbnails bottom right. */
  @media screen and (min-width: 768px) {
    .img-slider__content {
      bottom: 2.5rem;
      right: auto;
    }

    .img-slider__nav {
      right: var(--gutter);
      bottom: 2.5rem;
      justify-content: flex-end;
      max-width: 40vw;
    }
  }

  @media screen and (max-width: 991px) {
    .img-slider__list {
      width: 100%;
    }

    .img-slider__thumb {
      flex: none;
    }
  }

  @media screen and (max-width: 767px) {
    .img-slider__nav {
      flex-flow: wrap;
    }

    .img-slider__nav {
      --thumb-width: 5rem;
    }
  }

  @media screen and (max-width: 479px) {
    .img-slider__nav {
      --thumb-width: 4.5rem;
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { Observer } from "gsap/Observer";
  import { CustomEase } from "gsap/CustomEase";

  gsap.registerPlugin(Observer, CustomEase);
  CustomEase.create("slideshow-wipe", "0.6, 0.08, 0.02, 0.99");

  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  function initSlideShow(el: HTMLElement) {
    // Save all elements in an object for easy reference
    const ui = {
      el,
      slides: Array.from(el.querySelectorAll<HTMLElement>('[data-slideshow="slide"]')),
      inner: Array.from(el.querySelectorAll<HTMLElement>('[data-slideshow="parallax"]')),
      thumbs: Array.from(el.querySelectorAll<HTMLElement>('[data-slideshow="thumb"]')),
    };

    let current = 0;
    const length = ui.slides.length;
    let animating = false;
    let observer: Observer;
    const animationDuration = reduceMotion ? 0 : 0.9; // Define the duration of your 'slide' here

    // Autoplay runs on GSAP's ticker, so it also pauses by itself while the
    // tab is in the background. Disabled entirely under reduced motion.
    const autoplayDelay = reduceMotion ? 0 : Number(el.dataset.slideshowAutoplay) || 0;
    let autoplay: gsap.core.Tween | null = null;
    let paused = false;

    function scheduleAutoplay() {
      autoplay?.kill();
      autoplay = autoplayDelay > 0 && !paused ? gsap.delayedCall(autoplayDelay, () => navigate(1)) : null;
    }

    // Pause/play toggle. Manual navigation keeps working while paused, and
    // resuming grants a full interval before the next slide.
    const toggle = el.querySelector<HTMLButtonElement>('[data-slideshow="toggle"]');

    function onToggle() {
      if (!toggle) return;
      paused = !paused;
      toggle.dataset.state = paused ? "paused" : "playing";
      toggle.setAttribute("aria-label", (paused ? toggle.dataset.labelPlay : toggle.dataset.labelPause) ?? "");
      if (paused) {
        autoplay?.kill();
      } else {
        scheduleAutoplay();
      }
    }

    if (toggle) {
      // Nothing to pause when autoplay is off (reduced motion).
      toggle.hidden = autoplayDelay === 0;
      toggle.addEventListener("click", onToggle);
    }

    ui.slides.forEach((slide, index) => {
      slide.setAttribute("data-index", String(index));
    });
    ui.thumbs.forEach((thumb, index) => {
      thumb.setAttribute("data-index", String(index));
    });

    ui.slides[current].classList.add("is--current");
    ui.thumbs[current].classList.add("is--current");

    function navigate(direction: number, targetIndex: number | null = null) {
      if (animating) return;
      animating = true;
      observer.disable();
      autoplay?.kill();

      const previous = current;
      current =
        targetIndex !== null && targetIndex !== undefined
          ? targetIndex
          : direction === 1
            ? current < length - 1
              ? current + 1
              : 0
            : current > 0
              ? current - 1
              : length - 1;

      const currentSlide = ui.slides[previous];
      const currentInner = ui.inner[previous];
      const upcomingSlide = ui.slides[current];
      const upcomingInner = ui.inner[current];

      gsap
        .timeline({
          defaults: {
            duration: animationDuration,
            ease: "slideshow-wipe",
          },
          onStart: function () {
            upcomingSlide.classList.add("is--current");
            ui.thumbs[previous].classList.remove("is--current");
            ui.thumbs[current].classList.add("is--current");
            ui.thumbs[previous].setAttribute("aria-pressed", "false");
            ui.thumbs[current].setAttribute("aria-pressed", "true");
          },
          onComplete: function () {
            currentSlide.classList.remove("is--current");
            animating = false;
            // Re-enable observer after a short delay
            setTimeout(() => observer.enable(), animationDuration);
            // Count the next interval from the end of this transition.
            scheduleAutoplay();
          },
        })
        .to(currentSlide, { xPercent: -direction * 100 }, 0)
        .to(currentInner, { xPercent: direction * 50 }, 0)
        .fromTo(upcomingSlide, { xPercent: direction * 100 }, { xPercent: 0 }, 0)
        .fromTo(upcomingInner, { xPercent: -direction * 50 }, { xPercent: 0 }, 0);
    }

    function onClick(event: Event) {
      const target = event.currentTarget as HTMLElement;
      const targetIndex = parseInt(target.getAttribute("data-index") ?? "0", 10);
      if (targetIndex === current || animating) return;
      const direction = targetIndex > current ? 1 : -1;
      navigate(direction, targetIndex);
    }

    ui.thumbs.forEach((thumb) => {
      thumb.addEventListener("click", onClick);
    });

    observer = Observer.create({
      target: el,
      type: "wheel,touch,pointer",
      // Drag events to go left/right
      onLeft: () => {
        if (!animating) navigate(1);
      },
      onRight: () => {
        if (!animating) navigate(-1);
      },
      // For wheel events, check horizontal movement
      onWheel: (event) => {
        if (animating) return;
        if (Math.abs(event.deltaX) > Math.abs(event.deltaY)) {
          if (event.deltaX > 50) {
            navigate(1);
          } else if (event.deltaX < -50) {
            navigate(-1);
          }
        }
      },
      wheelSpeed: -1,
      tolerance: 10,
    });

    scheduleAutoplay();

    // Cleanup function if you need it
    return {
      destroy: function () {
        if (observer) observer.kill();
        autoplay?.kill();
        toggle?.removeEventListener("click", onToggle);
        ui.thumbs.forEach((thumb) => {
          thumb.removeEventListener("click", onClick);
        });
      },
    };
  }

  function initParallaxImageGalleryThumbnails() {
    const wrappers = document.querySelectorAll<HTMLElement>('[data-slideshow="wrap"]');
    wrappers.forEach((wrap) => initSlideShow(wrap));
  }

  // Astro bundles this as a deferred module, so the DOM is already parsed here.
  initParallaxImageGalleryThumbnails();
</script>
